// ============================================================================
// RawX Example 10: Unified Cross-Platform Source (Windows, Linux, macOS)
// Uses conditional preprocessor directives (%ifdef) to compile natively
// on Windows (Win64 API), Linux (ELF64 syscalls), or macOS (Mach-O syscalls)
// from the EXACT SAME source file!
// ============================================================================

section .data
    msg: db " [RawX Universal] Running same source code across all platforms!\n", 0

%ifdef TARGET_WINDOWS
    // Windows section data & variables
    written: resb 8
%endif

section .text

%ifdef TARGET_LINUX
entry _start
_start:
    // Linux write syscall: RAX=1, RDI=1 (stdout), RSI=buf, RDX=len
    mov rax, 1
    mov rdi, 1
    lea rsi, [msg]
    mov rdx, 65
    syscall

    // Linux exit syscall: RAX=60, RDI=0
    mov rax, 60
    mov rdi, 0
    syscall
%endif

%ifdef TARGET_MACOS
entry main
main:
    // macOS BSD write syscall: RAX=0x2000004, RDI=1 (stdout), RSI=buf, RDX=len
    mov rax, 0x2000004
    mov rdi, 1
    lea rsi, [msg]
    mov rdx, 65
    syscall

    // macOS BSD exit syscall: RAX=0x2000001, RDI=0
    mov rax, 0x2000001
    mov rdi, 0
    syscall
%endif

%ifdef TARGET_WINDOWS
entry main
main:
    sub rsp, 40

    // Windows Win64 ABI: GetStdHandle(STD_OUTPUT_HANDLE = -11)
    mov rcx, -11
    call GetStdHandle
    mov rbx, rax

    // WriteFile(stdout, msg, len, &written, NULL)
    mov rcx, rbx
    lea rdx, [msg]
    mov r8, 65
    lea r9, [written]
    mov qword [rsp + 32], 0
    call WriteFile

    // ExitProcess(0)
    mov rcx, 0
    call ExitProcess

    add rsp, 40
    ret
%endif
